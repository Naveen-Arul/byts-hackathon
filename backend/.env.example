# 🔐 OneCompiler API Configuration
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=onecompiler-apis.p.rapidapi.com
ONECOMPILER_URL=https://onecompiler-apis.p.rapidapi.com/api/v1/run

# 🤖 Local Ollama Primary Model Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
USE_OLLAMA_PRIMARY=true

# ☁️ Groq Fallback Backup Models Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BACKUP_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-120b,openai/gpt-oss-20b

# 🗝️ Groq Agent Keys (Optional)
GROQ_KEY_INTENT=
GROQ_KEY_LOGIC=
GROQ_KEY_TESTCASE=
GROQ_KEY_COMPLEXITY=
GROQ_KEY_HARDCODING=
GROQ_KEY_SECURITY=
GROQ_KEY_ADVERSARIAL=
GROQ_KEY_FEEDBACK=
GROQ_KEY_JUDGE=
GROQ_BACKUP_KEYS=

# 🌐 Server Configuration
PORT=5000
